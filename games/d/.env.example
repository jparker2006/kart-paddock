# Client defaults (dev). Copy to .env to override locally. Never commit real secrets.
# Base path of the game (must end with a trailing slash). Examples: / or /games/a/
BASE_PATH=/
# Public URL of the game backend (the browser connects here).
VITE_GAME_SERVER_URL=http://localhost:3001
CLIENT_PORT=5173
PREVIEW_PORT=4173
# Backend settings (also read at runtime by the server).
PORT=3001
HOST=0.0.0.0
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
