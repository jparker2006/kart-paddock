# ---- Client (build time / dev time, Vite) ----
# Base path the client is served under. Default "/".
# Must have a leading and trailing slash when nested, e.g. "/games/a/".
BASE_PATH=/

# Public URL of the game backend (Node + Socket.IO server).
# Local default; set to your production HTTPS URL (e.g. https://my-app.onrender.com).
VITE_GAME_SERVER_URL=http://localhost:3001

# Local dev ports (frontend)
CLIENT_PORT=5173
PREVIEW_PORT=4173

# ---- Backend (runtime, Node) ----
# Port the backend listens on. Honors the hosting provider's PORT value.
PORT=3001
# Bind address.
HOST=0.0.0.0
# Comma-separated list of browser origins allowed to connect (HTTP + WebSocket).
# Example for production: https://my-site.vercel.app
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
