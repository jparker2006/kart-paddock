# Client Build and Development Configuration
# Base path for client assets and routing (must have trailing slash if nested, e.g. /games/kart/)
BASE_PATH=/

# Public backend URL used by the browser client to establish WebSocket/HTTP connection
VITE_GAME_SERVER_URL=http://localhost:3001

# Local dev and preview ports
CLIENT_PORT=5173
PREVIEW_PORT=4173

# Backend Server Runtime Configuration
PORT=3001
HOST=0.0.0.0

# Comma-separated list of permitted origins for CORS and Socket.IO
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
