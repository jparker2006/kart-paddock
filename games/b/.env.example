# ---------------------------------------------------------------------------
# Bumble Rally configuration (copy to .env for local overrides)
# Every value below is optional; the defaults are shown.
# ---------------------------------------------------------------------------

# --- Client (read at `npm run dev` / `npm run build` / `npm run preview`) ---

# URL prefix the static client is served from. Use a trailing slash.
# Examples: "/" (default) or "/games/a/" when nested inside another website.
BASE_PATH=/

# Public URL of the game backend the browser connects to (HTTP(S) origin, no path).
# Production: the HTTPS URL of the hosted Node backend, e.g. https://bumble-rally.onrender.com
VITE_GAME_SERVER_URL=http://localhost:3001

# Local frontend dev-server port (Vite). A conflict is reported, never auto-changed.
CLIENT_PORT=5173

# Local port for `npm run preview` (serves the built client from dist/client).
PREVIEW_PORT=4173

# --- Backend (read at `npm run dev` / `npm start`) ---

# Port the Node backend listens on. Hosting providers usually inject PORT.
PORT=3001

# Bind address for the backend.
HOST=0.0.0.0

# Comma-separated list of browser origins allowed to talk to the backend
# (HTTP + WebSocket). Add the production website origin here, e.g.
# ALLOWED_ORIGINS=https://my-site.vercel.app,http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
